rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user's role from Firestore
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    // Check if the user is accessing their own data
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ============================================
    // Users Collection
    // ============================================
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // Only admins can create users (via Cloud Functions preferred)
      allow create: if isAdmin();

      // Users can only update their own lastLogin and boundDeviceId
      // Admins can update any field
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastLogin', 'boundDeviceId'])
      );

      // Only admins can delete users
      allow delete: if isAdmin();

      // Watch Progress subcollection
      match /watchProgress/{videoId} {
        // Users can read/write their own watch progress
        allow read, write: if isOwner(userId);
        // Admins can read all watch progress
        allow read: if isAdmin();
      }
    }

    // ============================================
    // Videos Collection
    // ============================================
    match /videos/{videoId} {
      // Authenticated users can read active videos
      // (actual access control is enforced in the app/Cloud Functions)
      allow read: if isAuthenticated();

      // Only admins can create, update, or delete videos
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // Default: Deny all other access
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
